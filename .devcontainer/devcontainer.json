{
  "name": "Day Planner",
  "image": "mcr.microsoft.com/devcontainers/javascript-node:22",
  "containerEnv": { "TZ": "Asia/Kolkata" },
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Your app",
      "onAutoForward": "openPreview"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "esbenp.prettier-vscode"
      ],
      "settings": {
        "workbench.startupEditor": "readme",
        "files.autoSave": "afterDelay",
        "files.autoSaveDelay": 1000,
        "terminal.integrated.defaultProfile.linux": "bash"
      }
    }
  },
  "postCreateCommand": "node --version && echo '' && echo 'Ready. Node is installed. Nothing else to set up.' && echo 'Open days/day-1.md and start at Step 1.'"
}
